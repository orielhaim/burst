# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://burst:burst@localhost:5432/burst

# --- Better Auth (API server) ---
# Generate with: bunx auth@latest secret
BETTER_AUTH_SECRET=
# Base URL of the API server (auth routes are served here)
BETTER_AUTH_URL=http://localhost:3001

# --- CORS / trusted origins (comma-separated) ---
# Browser origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# --- Game tickets (API signs, game-server verifies) ---
# Separate secret from BETTER_AUTH_SECRET. Generate with: openssl rand -base64 32
GAME_TICKET_SECRET=
GAME_TICKET_TTL_SECONDS=300

# --- Ports ---
API_PORT=3001
GAME_SERVER_PORT=2567
WEB_PORT=3000
